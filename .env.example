# ==============================================================================
# Syntrak Environment Configuration & Secrets Template (.env)
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# SQL Database Configuration (Optional - defaults to ~/.syntrak/syntrak.db)
# Supports file paths or SQLite URLs (e.g. sqlite:///path/to/db.sqlite)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///~/.syntrak/syntrak.db

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Authentication
# Get your Client ID from: https://console.cloud.google.com/apis/credentials
# Make sure to add http://localhost:8000 to Authorized JavaScript Origins.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# JWT Authentication Secret Key (Optional - auto-generated if blank)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Model name (e.g., "openai/gpt-4o", "anthropic/claude-3-5-sonnet-20240620",
# "ollama/qwen2.5-coder:32b", "openai/nvidia/nemotron-3-ultra-550b-a55b", etc.)
LLM_MODEL=ollama/qwen2.5-coder:latest

# Custom API endpoint (e.g. for Ollama: http://localhost:11434, NVIDIA: https://integrate.api.nvidia.com/v1)
LLM_API_BASE=

# ------------------------------------------------------------------------------
# Provider API Keys
# Syntrak automatically picks up API keys from standard environment variables:
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# Or set a generic LLM API key override:
LLM_API_KEY=
